#!/usr/bin/env bash
# Gate G9: refuse a commit if docs/ fails the quality gate, or a private file is staged.
set -eu
cd "$(git rev-parse --show-toplevel)"
staged="$(git diff --cached --name-only)"
if printf '%s\n' "$staged" | grep -Eq 'names\.txt|questions\.json|12-Progress|TRACKER\.md|session-logs/|09-Proof/|(^|/)private/|(^|/)debriefs/|coaching[-_]log'; then
  echo "pre-commit: a private file is staged (names, question bank, tracker, progress log, session log, proof). Unstage it."
  exit 1
fi
if [ -n "$(git diff --cached --name-only -- docs content practice)" ]; then
  python3 tools/gate.py
fi
